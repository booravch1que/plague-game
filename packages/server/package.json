{
  "name": "@plague/server",
  "version": "0.1.0",
  "private": true,
  "description": "Rooms, sessions and timers around the game engine. Transport-agnostic core.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@plague/engine": "workspace:*",
    "@plague/protocol": "workspace:*",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.0"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  }
}
