# Port and interface the server listens on.
PORT=3000
HOST=0.0.0.0
# Set to 1 when running behind a reverse proxy / load balancer so per-IP limits use X-Forwarded-For.
TRUST_PROXY=0
# Only needed if the web client is hosted on a different origin than this server (comma-separated).
# ALLOWED_ORIGINS=https://play.example.com
# Directory with the built web client (default: packages/web/dist).
# WEB_DIR=/app/packages/web/dist
# Fewest players to start a game (default 5). Set to 1 to try the game alone.
# MIN_PLAYERS=5
